# Zoho Mail SMTP configuration for the server-side contact form.
# Do not commit real credentials. Use .env.local for local development
# and Vercel Environment Variables for production.
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=info@ourfaces.net
ZOHO_SMTP_APP_PASSWORD=replace-with-a-dedicated-zoho-app-password
CONTACT_TO_EMAIL=info@ourfaces.net
